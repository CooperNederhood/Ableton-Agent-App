{
  "name": "@ableton-agent/desktop",
  "version": "0.1.0",
  "description": "Ableton Agent desktop application",
  "author": "Ableton Agent contributors",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:preload && pnpm build:electron",
    "build:dependencies": "pnpm --filter '@ableton-agent/desktop^...' build",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "clean": "rm -rf dist",
    "dev": "node scripts/run-development.mjs",
    "dev:debug": "node scripts/run-development.mjs --debug",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "remote-script": "pnpm --filter @ableton-agent/shared build && pnpm build:electron && node dist/main/remote-script-cli.js",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.preload.json --noEmit"
  },
  "dependencies": {
    "@ableton-agent/agent-config": "workspace:*",
    "@ableton-agent/application": "workspace:*",
    "@ableton-agent/correlation": "workspace:*",
    "@ableton-agent/debug-control": "workspace:*",
    "@ableton-agent/observability": "workspace:*",
    "@ableton-agent/protocol": "workspace:*",
    "@ableton-agent/runtime": "workspace:*",
    "@ableton-agent/shared": "workspace:*",
    "@ableton-agent/signal-routing": "workspace:*",
    "@ableton-agent/storage": "workspace:*",
    "@ableton-agent/tools": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.17"
  },
  "optionalDependencies": {
    "@github/copilot-sdk-darwin-arm64": "1.0.14",
    "@github/copilot-sdk-darwin-x64": "1.0.14",
    "@koromix/koffi-darwin-arm64": "3.3.0",
    "@koromix/koffi-darwin-x64": "3.3.0"
  },
  "devDependencies": {
    "@ableton-agent/test-support": "workspace:*",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "37.2.6",
    "electron-builder": "26.15.3",
    "vite": "^7.1.3"
  }
}
