{
  "schemaVersion": 1,
  "id": "arrangement-long-form-listening",
  "fixtureId": "arrangement-long-form-listening",
  "requiredCapabilities": ["automation", "arrangement-audio", "persistence"],
  "permissions": [
    {
      "tool": "ableton_listening",
      "action": "play-arrangement-and-listen",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["listen"],
      "arguments": {
        "action": "play-arrangement-and-listen",
        "listenerIds.0": "$source.listenerId",
