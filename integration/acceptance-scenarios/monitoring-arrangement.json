{
  "schemaVersion": 1,
  "id": "monitoring-arrangement",
  "fixtureId": "monitoring-patterns",
  "requiredCapabilities": ["automation", "session-midi"],
  "permissions": [
    {
      "tool": "ableton_transport",
      "action": "seek",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["monitor"],
      "arguments": {
        "action": "seek",
        "time": 0
      }
    },
    {
      "tool": "ableton_transport",
      "action": "set-playing",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["monitor"],
      "arguments": {
        "action": "set-playing",
        "isPlaying": true
      }
    },
    {
      "tool": "ableton_transport",
      "action": "set-playing",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["monitor"],
      "arguments": {
        "action": "set-playing",
        "isPlaying": false
      }
    }
  ],
  "budget": {
    "runMs": 480000,
    "cleanupMs": 60000,
    "persistenceMs": 30000
  },
  "steps": [
    {
      "id": "monitor",
      "message": "Move the Arrangement playhead to the start. Then monitor the operator track for 32 bars, looking for patterns up to 8 bars long, and play the Arrangement. Follow along until monitoring finishes, then tell me the bar where its pattern first settled, the bar where it changed, and the bar where the new pattern settled.",
      "timeoutMs": 420000,
      "assertions": [
        {
          "name": "monitoring-episodes",
          "parameters": {
            "changeBars": "25",
            "slackBars": 2,
            "establishBars": 3
          }
        }
      ]
    }
  ],
  "assertions": []
}
