{
  "schemaVersion": 1,
  "id": "session-drum-rack-listening",
  "fixtureId": "session-drum-rack-listening",
  "requiredCapabilities": ["automation", "session-midi", "persistence"],
  "permissions": [
    {
      "tool": "ableton_listening",
      "action": "play-session-and-listen",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["listen"],
      "arguments": {
        "action": "play-session-and-listen",
        "target.view": "session",
        "target.track.kind": "regular",
        "target.track.index": 0,
        "target.track.expectedReference": "$source.trackId",
        "target.track.expectedName": "1-808 Core Kit",
        "target.sceneIndex": "$source.slotIndex",
        "target.expectedClipReference": "$source.clipId",
        "target.expectedClipName": "clip-1",
        "listenerIds.0": "$source.listenerId"
      }
    }
  ],
  "budget": {
    "runMs": 300000,
    "cleanupMs": 30000,
    "persistenceMs": 30000
  },
  "steps": [
    {
      "id": "listen",
      "sourceId": "a",
      "message": "listen to clip-1",
      "timeoutMs": 120000,
      "assertions": [
        {
          "name": "capture",
          "parameters": {
            "sourceId": "a",
            "sampleRate": 48000,
            "expectedFrames": 90000,
            "metricFamilies": "level,spectral-centroid,attacks"
          }
        },
        {
          "name": "context",
          "parameters": {
            "afterRestart": false
          }
        }
      ]
    }
  ],
  "assertions": [
    {
      "name": "capture-count",
      "parameters": {
        "expected": 1
      }
    },
    {
      "name": "context",
      "parameters": {
        "afterRestart": true
      }
    },
    {
      "name": "unchanged",
      "parameters": {
        "scopes": "session-structure,source-settings,fixture-media,unrelated-playback"
      }
    }
  ]
}
