{
  "schemaVersion": 1,
  "id": "session-stopped-quantized-midi",
  "fixtureId": "session-stopped-quantized",
  "requiredCapabilities": ["automation", "session-audio", "session-midi"],
  "permissions": [
    {
      "tool": "ableton_listening",
      "action": "play-session-and-listen",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["listen"],
      "arguments": {
        "action": "play-session-and-listen",
        "target.view": "session",
        "target.track.kind": "regular",
        "target.track.index": 1,
        "target.track.expectedReference": "$source.trackId",
        "target.track.expectedName": "midi-track",
        "target.sceneIndex": "$source.slotIndex",
        "target.expectedClipReference": "$source.clipId",
        "target.expectedClipName": "clip-2",
        "listenerIds.0": "$source.listenerId"
      }
    }
  ],
  "budget": { "runMs": 300000, "cleanupMs": 30000, "persistenceMs": 30000 },
  "steps": [
    {
      "id": "listen",
      "sourceId": "b",
      "message": "Listen to the first Session clip on track midi-track.",
      "timeoutMs": 120000,
      "assertions": [
        {
          "name": "capture",
          "parameters": {
            "sourceId": "b",
            "sampleRate": 48000,
            "expectedFrames": 90000,
            "metricFamilies": "level,spectral-centroid,attacks"
          }
        },
        { "name": "context", "parameters": { "afterRestart": false } }
      ]
    }
  ],
  "assertions": [
    { "name": "capture-count", "parameters": { "expected": 1 } },
    {
      "name": "unchanged",
      "parameters": {
        "scopes": "session-structure,source-settings,fixture-media,unrelated-playback"
      }
    }
  ]
}
