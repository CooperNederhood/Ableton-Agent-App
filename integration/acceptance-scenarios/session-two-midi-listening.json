{
  "schemaVersion": 1,
  "id": "session-two-midi-listening",
  "fixtureId": "session-two-midi-listening",
  "requiredCapabilities": ["automation", "session-midi"],
  "permissions": [
    {
      "tool": "ableton_listening",
      "action": "play-session-and-listen",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["listen-operator"],
      "arguments": {
        "action": "play-session-and-listen",
        "target.view": "session",
        "target.track.kind": "regular",
        "target.track.index": 0,
        "target.track.expectedReference": "$source.trackId",
        "target.track.expectedName": "1-Operator",
        "target.sceneIndex": "$source.slotIndex",
        "target.expectedClipReference": "$source.clipId",
        "target.expectedClipName": "clip-1",
        "listenerIds.0": "$source.listenerId",
        "durationBeats": 4
      }
    },
    {
      "tool": "ableton_listening",
      "action": "play-session-and-listen",
      "risk": "medium",
      "maxUses": 1,
      "stepIds": ["listen-drums"],
      "arguments": {
        "action": "play-session-and-listen",
        "target.view": "session",
        "target.track.kind": "regular",
        "target.track.index": 1,
        "target.track.expectedReference": "$source.trackId",
        "target.track.expectedName": "2-808 Core Kit",
        "target.sceneIndex": "$source.slotIndex",
        "target.expectedClipReference": "$source.clipId",
        "target.expectedClipName": "clip-2",
        "listenerIds.0": "$source.listenerId",
        "durationBeats": 4
      }
    }
  ],
  "budget": { "runMs": 630000, "cleanupMs": 30000, "persistenceMs": 30000 },
  "steps": [
    {
      "id": "listen-operator",
      "sourceId": "a",
      "message": "Listen to the first Session clip clip-1 on track 1-Operator for four beats. Make exactly one new capture. If it fails, stop and report the failure without retrying.",
      "timeoutMs": 300000,
      "assertions": [
        {
          "name": "capture",
          "parameters": {
            "sourceId": "a",
            "sampleRate": 48000,
            "expectedFrames": 90000,
            "metricFamilies": "level,spectral-centroid,attacks,mel-bands,pitch,spectral-shape"
          }
        },
        { "name": "context", "parameters": { "afterRestart": false } }
      ]
    },
    {
      "id": "listen-drums",
      "sourceId": "b",
      "setupActions": ["stop-transport"],
      "message": "Listen to the first Session clip clip-2 on track 2-808 Core Kit for four beats. Make exactly one new capture. If it fails, stop and report the failure without retrying.",
      "timeoutMs": 300000,
      "assertions": [
        {
          "name": "capture",
          "parameters": {
            "sourceId": "b",
            "sampleRate": 48000,
            "expectedFrames": 90000,
            "metricFamilies": "level,spectral-centroid,attacks,mel-bands,pitch,spectral-shape"
          }
        },
        { "name": "context", "parameters": { "afterRestart": false } }
      ]
    }
  ],
  "assertions": [
    { "name": "capture-count", "parameters": { "expected": 2 } },
    { "name": "native-freshness", "parameters": {} },
    { "name": "context", "parameters": { "afterRestart": false } },
    {
      "name": "unchanged",
      "parameters": {
        "scopes": "session-structure,source-settings,fixture-media,unrelated-playback,project-file"
      }
    }
  ]
}
