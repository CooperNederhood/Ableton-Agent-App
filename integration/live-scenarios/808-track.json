{
  "formatVersion": 1,
  "id": "808-track",
  "group": "tracks",
  "prompt": "create a new track and add an 808 drum rack to it",
  "artifactPrefix": "AA_SMOKE_808_",
  "allowedTools": [
    "ableton_session",
    "ableton_browser",
    "ableton_tracks",
    "ableton_devices"
  ],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"],
    "ableton_browser": ["roots", "children", "search", "load-item"],
    "ableton_tracks": ["create"],
    "ableton_devices": ["inspect"]
  },
  "allowedRisks": ["read", "reversible"],
  "maxToolCalls": 12,
  "maxMutations": 2,
  "timeoutMs": 180000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_tracks",
      "beforeAction": "search",
      "afterAction": "create"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_browser",
      "beforeAction": "create",
      "afterAction": "load-item"
    }
  ],
  "trackNameSuffixes": ["808 Drums"],
  "clipNameSuffixes": [],
  "browserItemNames": ["808 Core Kit.adg"],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "808 Drums",
      "trackKind": "midi",
      "deviceName": "808 Core Kit"
    }
  ]
}
