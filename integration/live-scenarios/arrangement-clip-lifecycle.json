{
  "formatVersion": 1,
  "id": "arrangement-clip-lifecycle",
  "group": "arrangement-and-cues",
  "prompt": "Create a temporary Session MIDI clip, duplicate it into Arrangement, inspect the exact result, and remove every generated artifact.",
  "artifactPrefix": "AA_SMOKE_ARR_",
  "allowedTools": [
    "ableton_session",
    "ableton_tracks",
    "ableton_session_clips",
    "ableton_arrangement"
  ],
  "allowedActions": {
    "ableton_session": ["inspect"],
    "ableton_tracks": ["create", "delete"],
    "ableton_session_clips": ["create-midi", "delete"],
    "ableton_arrangement": ["duplicate-clip", "inspect", "delete-clip"]
  },
  "allowedRisks": ["read", "reversible", "destructive"],
  "maxToolCalls": 12,
  "maxMutations": 6,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_tracks",
      "after": "ableton_session_clips",
      "beforeAction": "create",
      "afterAction": "create-midi"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_arrangement",
      "beforeAction": "create-midi",
      "afterAction": "duplicate-clip"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_arrangement",
      "beforeAction": "duplicate-clip",
      "afterAction": "inspect"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_arrangement",
      "beforeAction": "inspect",
      "afterAction": "delete-clip"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_session_clips",
      "beforeAction": "delete-clip",
      "afterAction": "delete"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_tracks",
      "beforeAction": "delete",
      "afterAction": "delete"
    }
  ],
  "trackNameSuffixes": ["Track"],
  "clipNameSuffixes": ["Source"],
  "assertions": [
    {
      "type": "arrangement-clip-lifecycle",
      "trackNameSuffix": "Track",
      "clipNameSuffix": "Source",
      "sourceSceneIndex": 4,
      "length": 4,
      "destinationTime": 32
    }
  ]
}
