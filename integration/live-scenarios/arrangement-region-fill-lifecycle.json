{
  "formatVersion": 1,
  "id": "arrangement-region-fill-lifecycle",
  "group": "arrangement-and-cues",
  "prompt": "Create a temporary Session MIDI clip, fill a multi-tile Arrangement region with one bulk call, verify the exact result, and remove every generated artifact.",
  "artifactPrefix": "AA_SMOKE_FILL_",
  "allowedTools": [
    "ableton_session",
    "ableton_tracks",
    "ableton_session_clips",
    "ableton_arrangement"
  ],
  "allowedActions": {
    "ableton_session": ["inspect"],
    "ableton_tracks": ["create", "delete"],
    "ableton_session_clips": ["create-midi", "delete"],
    "ableton_arrangement": ["fill-region", "inspect", "delete-clip"]
  },
  "allowedRisks": ["read", "reversible", "destructive"],
  "maxToolCalls": 14,
  "maxMutations": 8,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_tracks",
      "after": "ableton_session_clips",
      "beforeAction": "create",
      "afterAction": "create-midi"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_arrangement",
      "beforeAction": "create-midi",
      "afterAction": "fill-region"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_arrangement",
      "beforeAction": "fill-region",
      "afterAction": "inspect"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_arrangement",
      "beforeAction": "inspect",
      "afterAction": "delete-clip"
    },
    {
      "before": "ableton_arrangement",
      "after": "ableton_session_clips",
      "beforeAction": "delete-clip",
      "afterAction": "delete"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_tracks",
      "beforeAction": "delete",
      "afterAction": "delete"
    }
  ],
  "trackNameSuffixes": ["Track"],
  "clipNameSuffixes": ["Source"],
  "assertions": [
    {
      "type": "arrangement-region-fill-lifecycle",
      "trackNameSuffix": "Track",
      "clipNameSuffix": "Source",
      "sourceSceneIndex": 5,
      "sourceLength": 4,
      "regionStart": 32,
      "regionEnd": 42,
      "expectedTileCount": 2,
      "expectedUnusedRemainder": 2
    }
  ]
}
