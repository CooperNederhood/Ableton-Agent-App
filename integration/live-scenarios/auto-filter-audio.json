{
  "formatVersion": 1,
  "id": "auto-filter-audio",
  "group": "audio-effects",
  "prompt": "first search the Ableton browser for the Auto Filter audio effect and wait for the result; then create one new audio track and load that verified Auto Filter item onto it",
  "artifactPrefix": "AA_SMOKE_FX_",
  "allowedTools": [
    "ableton_session",
    "ableton_browser",
    "ableton_tracks",
    "ableton_devices"
  ],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"],
    "ableton_browser": ["search", "children", "load-item"],
    "ableton_tracks": ["create"],
    "ableton_devices": ["inspect"]
  },
  "allowedRisks": ["read", "reversible"],
  "maxToolCalls": 10,
  "maxMutations": 2,
  "timeoutMs": 180000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_tracks",
      "beforeAction": "search",
      "afterAction": "create"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_browser",
      "beforeAction": "create",
      "afterAction": "load-item"
    }
  ],
  "trackNameSuffixes": ["Filtered Audio"],
  "clipNameSuffixes": [],
  "browserItemNames": ["Auto Filter"],
  "browserLoadTargets": [
    {
      "trackNameSuffix": "Filtered Audio",
      "itemName": "Auto Filter"
    }
  ],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "Filtered Audio",
      "trackKind": "audio",
      "deviceName": "Auto Filter"
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 2,
          "action": "search"
        },
        {
          "toolName": "ableton_tracks",
          "min": 1,
          "max": 1,
          "action": "create"
        },
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 1,
          "action": "load-item"
        }
      ]
    }
  ]
}
