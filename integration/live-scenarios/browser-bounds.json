{
  "formatVersion": 1,
  "id": "browser-bounds",
  "group": "inspection",
  "prompt": "Make exactly three read-only ableton_browser calls in this order. First call roots. Second call children for the returned Drums root, copying its expectedItemReference, expectedItemRoot, expectedItemPath, expectedItemName, and expectedItemUri exactly and passing offset 0 and limit 20; do not pass maxDepth. Third call search with query 808, roots [drums, packs, user_library], and maxResults 20. Do not make other tool calls, load anything, or change the Set.",
  "artifactPrefix": "AA_SMOKE_BROWSER_",
  "allowedTools": ["ableton_browser"],
  "allowedActions": {
    "ableton_browser": ["roots", "children", "search"]
  },
  "allowedRisks": ["read"],
  "maxToolCalls": 3,
  "maxMutations": 0,
  "timeoutMs": 180000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_browser",
      "beforeAction": "roots",
      "afterAction": "children"
    }
  ],
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": [
        "browser.inspect_roots",
        "browser.inspect_children",
        "browser.search"
      ]
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 1,
          "action": "roots"
        },
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 1,
          "action": "children"
        },
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 1,
          "action": "search"
        }
      ]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
