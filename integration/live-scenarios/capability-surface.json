{
  "formatVersion": 1,
  "id": "capability-surface",
  "group": "inspection",
  "execution": "capability-surface",
  "artifactPrefix": "AA_SMOKE_CAPS_",
  "timeoutMs": 60000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": [
        "session.inspect",
        "tracks.create",
        "tracks.delete",
        "tracks.rename",
        "tracks.set_mixer",
        "clips.create_midi",
        "clips.inspect_notes",
        "clips.replace_notes",
        "clips.launch",
        "clips.duplicate",
        "clips.delete",
        "clips.set_properties",
        "arrangement.inspect",
        "arrangement.inspect_notes",
        "arrangement.replace_notes",
        "arrangement.duplicate_clip",
        "arrangement.fill_region",
        "arrangement.delete_clip",
        "arrangement.set_clip_properties",
        "devices.inspect",
        "devices.inspect_parameters",
        "devices.inspect_chain_mixer",
        "devices.find_position",
        "devices.move",
        "devices.set_chain_properties",
        "devices.set_chain_mixer",
        "devices.set_enabled",
        "devices.set_parameter",
        "browser.inspect_roots",
        "browser.inspect_children",
        "browser.search",
        "browser.load_item",
        "transport.inspect_arrangement",
        "transport.set_arrangement_loop",
        "transport.create_cue_point",
        "transport.delete_cue_point"
      ]
    }
  ]
}
