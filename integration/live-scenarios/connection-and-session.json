{
  "formatVersion": 1,
  "id": "connection-and-session",
  "group": "inspection",
  "prompt": "Make exactly one read-only call to ableton_session with action inspect, then briefly summarize the result. Do not make any other tool calls or changes.",
  "artifactPrefix": "AA_SMOKE_INSPECT_",
  "allowedTools": ["ableton_session"],
  "allowedActions": { "ableton_session": ["inspect"] },
  "allowedRisks": ["read"],
  "maxToolCalls": 1,
  "maxMutations": 0,
  "timeoutMs": 120000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": ["session.inspect"]
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_session",
          "min": 1,
          "max": 1,
          "action": "inspect"
        }
      ]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
