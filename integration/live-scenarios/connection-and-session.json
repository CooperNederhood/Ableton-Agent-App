{
  "formatVersion": 1,
  "id": "connection-and-session",
  "group": "inspection",
  "prompt": "Check the Ableton connection and inspect the current Live Set. Do not make any changes.",
  "artifactPrefix": "AA_SMOKE_INSPECT_",
  "allowedTools": ["ableton_session"],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"]
  },
  "allowedRisks": ["read"],
  "maxToolCalls": 2,
  "maxMutations": 0,
  "timeoutMs": 120000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": ["session.inspect"]
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_session",
          "min": 1,
          "max": 1,
          "action": "connection-status"
        },
        {
          "toolName": "ableton_session",
          "min": 1,
          "max": 1,
          "action": "inspect"
        }
      ]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
