{
  "formatVersion": 1,
  "id": "echo-parameter-inspection",
  "group": "audio-effects",
  "prompt": "first search the Ableton browser for the Echo audio effect and wait for the result; then create one new audio track named Echo Probe, load that verified Echo item onto it, and inspect the first 30 Echo parameters",
  "artifactPrefix": "AA_SMOKE_ECHO_",
  "allowedTools": [
    "ableton_session",
    "ableton_browser",
    "ableton_tracks",
    "ableton_devices"
  ],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"],
    "ableton_browser": ["search", "children", "load-item"],
    "ableton_tracks": ["create"],
    "ableton_devices": ["inspect", "inspect-parameters"]
  },
  "allowedRisks": ["read", "reversible"],
  "maxToolCalls": 12,
  "maxMutations": 2,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_tracks",
      "beforeAction": "search",
      "afterAction": "create"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_browser",
      "beforeAction": "create",
      "afterAction": "load-item"
    },
    {
      "before": "ableton_browser",
      "after": "ableton_devices",
      "beforeAction": "load-item",
      "afterAction": "inspect-parameters"
    }
  ],
  "trackNameSuffixes": ["Echo Probe"],
  "clipNameSuffixes": [],
  "browserItemNames": ["Echo"],
  "browserLoadTargets": [
    {
      "trackNameSuffix": "Echo Probe",
      "itemName": "Echo"
    }
  ],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "Echo Probe",
      "trackKind": "audio",
      "deviceName": "Echo"
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 2,
          "action": "search"
        },
        {
          "toolName": "ableton_tracks",
          "min": 1,
          "max": 1,
          "action": "create"
        },
        {
          "toolName": "ableton_browser",
          "min": 1,
          "max": 1,
          "action": "load-item"
        },
        {
          "toolName": "ableton_devices",
          "min": 1,
          "max": 1,
          "action": "inspect-parameters"
        }
      ]
    }
  ]
}
