{
  "formatVersion": 1,
  "id": "echo-parameter-inspection",
  "group": "audio-effects",
  "prompt": "first search the Ableton browser for the Echo audio effect and wait for the result; then create one new audio track named Echo Probe, load that verified Echo item onto it, and inspect the first 30 Echo parameters",
  "artifactPrefix": "AA_SMOKE_ECHO_",
  "allowedTools": [
    "ableton_connection_status",
    "ableton_session_inspect",
    "ableton_browser_search",
    "ableton_browser_children_inspect",
    "ableton_tracks_create",
    "ableton_browser_load_item",
    "ableton_devices_inspect",
    "ableton_device_parameters_inspect"
  ],
  "allowedRisks": ["read", "reversible"],
  "maxToolCalls": 12,
  "maxMutations": 2,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_browser_search",
      "after": "ableton_tracks_create"
    },
    {
      "before": "ableton_tracks_create",
      "after": "ableton_browser_load_item"
    },
    {
      "before": "ableton_browser_load_item",
      "after": "ableton_device_parameters_inspect"
    }
  ],
  "trackNameSuffixes": ["Echo Probe"],
  "clipNameSuffixes": [],
  "browserItemNames": ["Echo"],
  "browserLoadTargets": [
    {
      "trackNameSuffix": "Echo Probe",
      "itemName": "Echo"
    }
  ],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "Echo Probe",
      "trackKind": "audio",
      "deviceName": "Echo"
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_browser_search",
          "min": 1,
          "max": 2
        },
        {
          "toolName": "ableton_tracks_create",
          "min": 1,
          "max": 1
        },
        {
          "toolName": "ableton_browser_load_item",
          "min": 1,
          "max": 1
        },
        {
          "toolName": "ableton_device_parameters_inspect",
          "min": 1,
          "max": 1
        }
      ]
    }
  ]
}
