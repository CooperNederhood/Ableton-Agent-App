{
  "formatVersion": 1,
  "id": "four-on-floor",
  "group": "session-clips",
  "prompt": "create a new track and add an 808 drum rack to it, then add a new clip to it with a 4-on-the-floor drum beat",
  "artifactPrefix": "AA_SMOKE_4OTF_",
  "allowedTools": [
    "ableton_session",
    "ableton_browser",
    "ableton_tracks",
    "ableton_devices",
    "ableton_session_clips"
  ],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"],
    "ableton_browser": ["roots", "children", "search", "load-item"],
    "ableton_tracks": ["create"],
    "ableton_devices": ["inspect", "inspect-drum-rack-pads"],
    "ableton_session_clips": ["create-midi", "replace-notes"]
  },
  "allowedRisks": ["read", "reversible", "destructive"],
  "maxToolCalls": 16,
  "maxMutations": 4,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_tracks",
      "beforeAction": "search",
      "afterAction": "create"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_browser",
      "beforeAction": "create",
      "afterAction": "load-item"
    },
    {
      "before": "ableton_browser",
      "after": "ableton_session_clips",
      "beforeAction": "load-item",
      "afterAction": "create-midi"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_session_clips",
      "beforeAction": "create-midi",
      "afterAction": "replace-notes"
    }
  ],
  "trackNameSuffixes": ["808 Drums"],
  "clipNameSuffixes": ["Four on the Floor"],
  "browserItemNames": ["808 Core Kit.adg"],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "808 Drums",
      "trackKind": "midi",
      "deviceName": "808 Core Kit"
    },
    {
      "type": "session-midi-pattern",
      "trackNameSuffix": "808 Drums",
      "clipNameSuffix": "Four on the Floor",
      "sceneIndex": 0,
      "pitch": 36,
      "starts": [0, 1, 2, 3],
      "duration": 0.25,
      "velocity": 110
    }
  ]
}
