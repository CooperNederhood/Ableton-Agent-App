{
  "formatVersion": 1,
  "id": "piano-and-string-bass",
  "group": "instruments",
  "prompt": "create two new tracks: a piano and a string bass",
  "artifactPrefix": "AA_SMOKE_INST_",
  "allowedTools": [
    "ableton_session",
    "ableton_browser",
    "ableton_tracks",
    "ableton_devices"
  ],
  "allowedActions": {
    "ableton_session": ["connection-status", "inspect"],
    "ableton_browser": ["search", "children", "load-item"],
    "ableton_tracks": ["create"],
    "ableton_devices": ["inspect"]
  },
  "allowedRisks": ["read", "reversible"],
  "maxToolCalls": 14,
  "maxMutations": 4,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_browser",
      "after": "ableton_tracks",
      "beforeAction": "search",
      "afterAction": "create"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_browser",
      "beforeAction": "create",
      "afterAction": "load-item"
    }
  ],
  "trackNameSuffixes": ["Piano", "String Bass"],
  "clipNameSuffixes": [],
  "browserItemNames": ["Childhood Home Piano.adg", "Upright Bass.adv"],
  "browserLoadTargets": [
    {
      "trackNameSuffix": "Piano",
      "itemName": "Childhood Home Piano.adg"
    },
    {
      "trackNameSuffix": "String Bass",
      "itemName": "Upright Bass.adv"
    }
  ],
  "assertions": [
    {
      "type": "track-device",
      "trackNameSuffix": "Piano",
      "trackKind": "midi",
      "deviceName": "Childhood Home Piano"
    },
    {
      "type": "track-device",
      "trackNameSuffix": "String Bass",
      "trackKind": "midi",
      "deviceName": "Upright Bass"
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_browser",
          "min": 2,
          "max": 4,
          "action": "search"
        },
        {
          "toolName": "ableton_tracks",
          "min": 2,
          "max": 2,
          "action": "create"
        },
        {
          "toolName": "ableton_browser",
          "min": 2,
          "max": 2,
          "action": "load-item"
        }
      ]
    }
  ]
}
