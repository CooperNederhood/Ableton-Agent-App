{
  "formatVersion": 1,
  "id": "scenes-core-inspection",
  "group": "inspection",
  "prompt": "Use the consolidated Live 11 scene tool to list a bounded page of scenes, then inspect the first scene again by its exact runtime identity. Do not change the Live Set.",
  "artifactPrefix": "AA_SMOKE_SCENES_",
  "allowedTools": ["ableton_scenes"],
  "allowedRisks": ["read"],
  "maxToolCalls": 2,
  "maxMutations": 0,
  "timeoutMs": 120000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": ["scenes.list", "scenes.get"]
    },
    {
      "type": "tool-calls",
      "required": [{ "toolName": "ableton_scenes", "min": 2, "max": 2 }]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
