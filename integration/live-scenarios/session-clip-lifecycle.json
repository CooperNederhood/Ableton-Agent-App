{
  "formatVersion": 1,
  "id": "session-clip-lifecycle",
  "group": "session-clips",
  "prompt": "Create a temporary Session MIDI clip, update its properties, duplicate it, launch it, then delete the generated clips and track so the Set returns to its original state.",
  "artifactPrefix": "AA_SMOKE_SESSION_",
  "allowedTools": [
    "ableton_session",
    "ableton_tracks",
    "ableton_session_clips",
    "ableton_transport"
  ],
  "allowedActions": {
    "ableton_session": ["inspect"],
    "ableton_tracks": ["create", "delete"],
    "ableton_session_clips": [
      "create-midi",
      "set-properties",
      "duplicate",
      "launch",
      "delete"
    ],
    "ableton_transport": ["set-playing"]
  },
  "allowedRisks": ["read", "reversible", "destructive"],
  "maxToolCalls": 19,
  "maxMutations": 9,
  "timeoutMs": 240000,
  "ordering": [
    {
      "before": "ableton_tracks",
      "after": "ableton_session_clips",
      "beforeAction": "create",
      "afterAction": "create-midi"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_session_clips",
      "beforeAction": "create-midi",
      "afterAction": "launch"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_transport",
      "beforeAction": "launch",
      "afterAction": "set-playing"
    },
    {
      "before": "ableton_transport",
      "after": "ableton_session_clips",
      "beforeAction": "set-playing",
      "afterAction": "set-properties"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_session_clips",
      "beforeAction": "set-properties",
      "afterAction": "duplicate"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_session_clips",
      "beforeAction": "duplicate",
      "afterAction": "delete"
    },
    {
      "before": "ableton_session_clips",
      "after": "ableton_tracks",
      "beforeAction": "delete",
      "afterAction": "delete"
    }
  ],
  "trackNameSuffixes": ["Track"],
  "clipNameSuffixes": ["Source", "Renamed"],
  "assertions": [
    {
      "type": "session-clip-lifecycle",
      "trackNameSuffix": "Track",
      "initialClipNameSuffix": "Source",
      "finalClipNameSuffix": "Renamed",
      "sourceSceneIndex": 4,
      "destinationSceneIndex": 5,
      "length": 4,
      "properties": {
        "muted": true,
        "looping": false
      }
    }
  ]
}
