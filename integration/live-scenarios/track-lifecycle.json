{
  "formatVersion": 1,
  "id": "track-lifecycle",
  "group": "tracks",
  "prompt": "Create one temporary MIDI track, rename it, set its mixer state, verify it, and delete it so the Set returns to its original track state.",
  "artifactPrefix": "AA_SMOKE_TRACK_",
  "allowedTools": [
    "ableton_session",
    "ableton_tracks",
    "ableton_mixer_routing"
  ],
  "allowedActions": {
    "ableton_session": ["inspect"],
    "ableton_tracks": ["create", "rename", "delete"],
    "ableton_mixer_routing": ["set-track-mixer"]
  },
  "allowedRisks": ["read", "reversible", "destructive"],
  "maxToolCalls": 12,
  "maxMutations": 4,
  "timeoutMs": 180000,
  "ordering": [
    {
      "before": "ableton_tracks",
      "after": "ableton_tracks",
      "beforeAction": "create",
      "afterAction": "rename"
    },
    {
      "before": "ableton_tracks",
      "after": "ableton_mixer_routing",
      "beforeAction": "rename",
      "afterAction": "set-track-mixer"
    },
    {
      "before": "ableton_mixer_routing",
      "after": "ableton_tracks",
      "beforeAction": "set-track-mixer",
      "afterAction": "delete"
    }
  ],
  "trackNameSuffixes": ["Initial", "Final"],
  "assertions": [
    {
      "type": "track-lifecycle",
      "initialNameSuffix": "Initial",
      "finalNameSuffix": "Final",
      "trackKind": "midi",
      "mixer": {
        "isMuted": true,
        "isSoloed": true,
        "isArmed": true,
        "volume": 0.42,
        "pan": -0.25
      }
    }
  ]
}
