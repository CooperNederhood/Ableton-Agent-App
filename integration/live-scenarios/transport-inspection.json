{
  "formatVersion": 1,
  "id": "transport-inspection",
  "group": "inspection",
  "prompt": "Make exactly one read-only call to ableton_transport with action inspect-arrangement, then summarize playback, loop range, and cue points. Do not make any other tool calls or changes.",
  "artifactPrefix": "AA_SMOKE_TRANSPORT_",
  "allowedTools": ["ableton_transport"],
  "allowedActions": {
    "ableton_transport": ["inspect-arrangement"]
  },
  "allowedRisks": ["read"],
  "maxToolCalls": 1,
  "maxMutations": 0,
  "timeoutMs": 120000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": ["transport.inspect_arrangement"]
    },
    {
      "type": "tool-calls",
      "required": [
        {
          "toolName": "ableton_transport",
          "min": 1,
          "max": 1,
          "action": "inspect-arrangement"
        }
      ]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
