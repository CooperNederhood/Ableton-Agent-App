{
  "formatVersion": 1,
  "id": "workflow-state-inspection",
  "group": "inspection",
  "prompt": "Use the grouped Live 11 tools to inspect workflow state: call ableton_recording with action inspect, ableton_grooves with action list, ableton_selection_view once with action inspect-selection and once with action inspect-view, ableton_live_history with action inspect, and ableton_workflow_jobs with action list. Do not call any other tool, mutate Live, invoke undo/redo, or start/cancel a job.",
  "artifactPrefix": "AA_SMOKE_WORKFLOW_STATE_",
  "allowedTools": [
    "ableton_recording",
    "ableton_grooves",
    "ableton_selection_view",
    "ableton_live_history",
    "ableton_workflow_jobs"
  ],
  "allowedRisks": ["read"],
  "maxToolCalls": 6,
  "maxMutations": 0,
  "timeoutMs": 120000,
  "assertions": [
    {
      "type": "connection-capabilities",
      "requiredCapabilities": [
        "recording.inspect",
        "grooves.list",
        "selection_view.inspect_selection",
        "selection_view.inspect_view",
        "live_history.inspect",
        "workflow_jobs.list"
      ]
    },
    {
      "type": "tool-calls",
      "required": [
        { "toolName": "ableton_recording", "min": 1, "max": 1 },
        { "toolName": "ableton_grooves", "min": 1, "max": 1 },
        { "toolName": "ableton_selection_view", "min": 2, "max": 2 },
        { "toolName": "ableton_live_history", "min": 1, "max": 1 },
        { "toolName": "ableton_workflow_jobs", "min": 1, "max": 1 }
      ]
    },
    {
      "type": "session-unchanged"
    }
  ]
}
