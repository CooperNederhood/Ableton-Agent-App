          "code": "Param epoch(0); Param cancel(0);\nHistory seenEpoch(0); History clock(0); History armed(0); History active(0);\nHistory launchClock(-1); History sourceClock(-1); History onsetCount(0);\nHistory launchPhaseSamples(-1); History firstSourceClock(-1);\nHistory rejected(0); History previousPhase(0); History quietSamples(240);\nHistory stablePhaseSamples(0);\nHistory n(0);\nHistory sumL(0); History sumR(0);\nHistory peakL(0); History peakR(0);\nHistory heldL(0); History heldR(0);\nHistory heldRmsL(0); History heldRmsR(0);\nHistory completed(0);\nHistory envelopeEpoch(0); History preQuiet(0);\nHistory armCounter(-1);\nDelay preL(64); Delay preR(64);\nnewRequest = epoch != seenEpoch && epoch != 0;\nif (newRequest) { armCounter = in4; }\ndelayedL = preL.read(64); delayedR = preR.read(64);\npreL.write(in2); preR.write(in3);\nif (epoch != seenEpoch && epoch != 0) {\n  if (epoch > seenEpoch && epoch <= 1000000 && floor(epoch) == epoch) {\n    seenEpoch = epoch; clock = 0; armed = 0; active = 0;\n    launchClock = -1; sourceClock = -1; onsetCount = 0;\n    launchPhaseSamples = -1; firstSourceClock = -1;\n    quietSamples = 240; rejected = 0;\n    if (in1 != previousPhase || stablePhaseSamples < 64) { rejected = 1; }\n    else if (abs(in2) + abs(in3) > 0.000000000001) { rejected = 8; }\n    else { armed = 1; }\n  } else { armed = 0; active = 0; rejected = 6; }\n}\nif (epoch == 0) { armed = 0; active = 0; }\nif (seenEpoch > 0 && samplerate != 48000) {\n  armed = 0; active = 0; rejected = 5;\n}\nif (cancel > 0 && (armed > 0 || active > 0)) {\n  armed = 0; active = 0; rejected = 4;\n}\nif (armed > 0 && clock >= 480000) {\n  armed = 0; rejected = 2;\n}\nif (armed > 0 && in1 != previousPhase) {\n  launchClock = clock; armed = 0; active = 1;\n  launchPhaseSamples = round(in1 * 24000);\n}\nif (armed > 0 || active > 0) {\n  hasInput = abs(in2) + abs(in3) > 0.000000000001;\n  if (hasInput) {\n    if (quietSamples >= 240) {\n      sourceClock = clock;\n      if (onsetCount == 0) { firstSourceClock = clock; }\n      onsetCount = onsetCount + 1;\n      if (onsetCount > 8) { armed = 0; active = 0; rejected = 7; }\n    }\n    quietSamples = 0;\n  } else { quietSamples = min(240, quietSamples + 1); }\n}\nstablePhaseSamples = in1 == previousPhase ? min(128, stablePhaseSamples + 1) : 0;\nif (active > 0 && stablePhaseSamples >= 64) { active = 0; rejected = 3; }\nif (active > 0 && clock - launchClock + launchPhaseSamples >= 480064) { active = 0; }\nif ((armed > 0 || active > 0) &&\n  (!(in4 >= 0 && floor((in4 + 480000) / 1048576) < 16777216 && floor(in4) == in4) ||\n   in4 != armCounter + clock)) {\n  armed = 0; active = 0; rejected = 12;\n}\nif (envelopeEpoch != seenEpoch) {\n  envelopeEpoch = seenEpoch; n = 0; sumL = 0; sumR = 0; peakL = 0; peakR = 0; heldL = 0; heldR = 0; heldRmsL = 0; heldRmsR = 0; completed = 0;\n}\nif (newRequest && (armed > 0 || active > 0) && preQuiet < 64) {\n  armed = 0; active = 0; rejected = 10;\n}\norigin = launchClock - launchPhaseSamples;\nif (active > 0 && (launchPhaseSamples < 0 || launchPhaseSamples > 64 || origin < 0)) {\n  active = 0; rejected = 9;\n}\nrenderIndex = clock - origin - 64;\nif (active > 0 && renderIndex >= 0 && renderIndex < 480000) {\n  if (renderIndex != completed + n) { active = 0; rejected = 11; }\n  else {\nhop = max(1, round(samplerate / 10));\nsumL = sumL + delayedL * delayedL; sumR = sumR + delayedR * delayedR;\npeakL = max(peakL, abs(delayedL)); peakR = max(peakR, abs(delayedR));\nn = n + 1;\nif (n >= hop) {\n heldL = peakL; heldR = peakR;\n heldRmsL = sqrt(sumL / hop); heldRmsR = sqrt(sumR / hop);\n completed = completed + hop;\n n = 0; sumL = 0; sumR = 0; peakL = 0; peakR = 0;\n}\n  }\n}\npreQuiet = abs(in2) + abs(in3) <= 0.000000000001 ? min(64, preQuiet + 1) : 0;\nout9 = heldL; out10 = heldR; out11 = heldRmsL; out12 = heldRmsR;\nout13 = completed;\nout14 = armCounter; out15 = launchClock >= 0 ? armCounter + origin : -1;\nout1 = seenEpoch; out2 = launchClock; out3 = sourceClock;\nout4 = onsetCount; out5 = rejected; out6 = active;\nout7 = launchPhaseSamples; out8 = firstSourceClock;\npreviousPhase = in1;\nclock = clock + 1;",
