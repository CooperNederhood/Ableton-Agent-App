{
  "name": "@ableton-agent/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/prompts && cp prompts/*.md dist/prompts/",
    "clean": "rm -rf dist",
    "smoke:copilot-plan-exit": "node scripts/copilot-plan-exit-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ableton-agent/ableton-contracts": "workspace:*",
    "@ableton-agent/agent-config": "workspace:*",
    "@ableton-agent/protocol": "workspace:*",
    "@ableton-agent/shared": "workspace:*",
    "@ableton-agent/storage": "workspace:*",
    "@ableton-agent/tools": "workspace:*",
    "@github/copilot-sdk": "^1.0.9",
    "zod": "^4.3.6"
  }
}
